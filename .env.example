# ==========================================
# CONFIGURAÇÃO DO SERVIDOR
# ==========================================
PORT=4000
NODE_ENV=development

# ==========================================
# MONGODB
# ==========================================
MONGODB_URI=mongodb://localhost:27017/irrigacao_db

# ==========================================
# API EXTERNA (Spring Boot)
# ==========================================
# URL base da API externa que gerencia Usuários, Dispositivos, Setores e Propriedades
API_EXTERNA_URL=http://localhost:8080/api

# ==========================================
# GRAPHQL
# ==========================================
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# ==========================================
# SEGURANÇA (Opcional - para implementação futura)
# ==========================================
# JWT_SECRET=seu_segredo_aqui
# JWT_EXPIRES_IN=7d
